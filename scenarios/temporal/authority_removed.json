{
  "scenario_id": "authority_removed",
  "description": "A recognised principal is removed from the recognised authority set between two checks. The invalidating step removes the principal and issues a freshly signed request with a new nonce, isolating the failure to Authority.",
  "secret": "temporal-pack-secret-2",
  "known_principals": ["agent-alpha"],
  "max_age_seconds": 60.0,
  "initial_state": {},
  "request": {
    "action": "deploy_release",
    "principal": "agent-alpha",
    "nonce": "ar-nonce-1",
    "issued_at": 2000000.0,
    "granted_scopes": ["deploy_release"],
    "required_scope": "deploy_release",
    "assumed_state": {}
  },
  "steps": [
    {
      "step": 0,
      "event": "issue_request",
      "label": "principal recognised",
      "expected_verdict": "ALLOW"
    },
    {
      "step": 1,
      "event": "remove_authority_and_reissue",
      "principals": ["agent-alpha"],
      "new_nonce": "ar-nonce-2",
      "label": "principal removed; reissued with fresh nonce so failure isolates to Authority",
      "expected_verdict": "DENY",
      "expected_failed_property": "Authority"
    }
  ]
}
