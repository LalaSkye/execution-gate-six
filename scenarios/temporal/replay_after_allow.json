  "known_principals": ["agent-alpha"],
  "max_age_seconds": 60.0,
  "initial_state": {},
  "request": {
    "action": "rotate_key",
    "principal": "agent-alpha",
    "nonce": "raa-nonce-1",
    "issued_at": 5000000.0,
    "granted_scopes": ["rotate_key"],
    "required_scope": "rotate_key",
    "assumed_state": {}
  },
  "steps": [
    {
      "step": 0,
      "event": "issue_request",
      "label": "first submission",
      "expected_verdict": "ALLOW"
    },
    {
      "step": 1,
      "event": "submit_request",
      "label": "identical resubmission",
      "expected_verdict": "DENY",
      "expected_failed_property": "Replay"
    }
  ]
